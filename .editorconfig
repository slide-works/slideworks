# Code style, the minimal set matching .claude/skills/csharp-code-style: _camelCase
# private fields, UPPER_CASE constants, file-scoped namespaces, one type per file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,json,jsonl,yml,yaml}]
indent_size = 2

# The client. Prettier reads this file, so these must agree with .prettierrc.
[*.{ts,tsx,js,jsx,mjs,cjs,css,html}]
indent_size = 2

[.prettierrc]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.constants_upper.symbols = constants
dotnet_naming_rule.constants_upper.style = upper_case
dotnet_naming_rule.constants_upper.severity = suggestion
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.upper_case.capitalization = all_upper
dotnet_naming_style.upper_case.word_separator = _

# Analyzer tuning (SonarAnalyzer.CSharp + Agoda.Analyzers). Keep this list short; justify each line.
# S1135: a `TODO:` comment marks temporary behaviour. Informational: each TODO shows in the IDE's error list without
# failing the build (TreatWarningsAsErrors would turn a warning into an error).
dotnet_diagnostic.S1135.severity = suggestion

[src/SlideWorks.WebApi.Tests/**.cs]
# AG0010: fixtures inherit ApiTestFixture on purpose. It owns the app, the temp database and the
# authenticated client, so each fixture states only what it tests.
dotnet_diagnostic.AG0010.severity = none

[src/SlideWorks.AcceptanceTests/**.cs]
# AG0010: fixtures inherit AcceptanceTest on purpose. It owns the browser context and the URL of the
# running app, so each fixture states only the journey it tests.
dotnet_diagnostic.AG0010.severity = none
# AG0012: the assertions are Playwright's Expect(...), which retries until the page settles; the rule
# only recognises NUnit/Shouldly asserts and would push these onto non-retrying ones. Upstream: agoda-com/AgodaAnalyzers#254.
dotnet_diagnostic.AG0012.severity = none
