#!/usr/bin/env bash
# Builds a test project, checks what the filter selects, then runs only those tests under the lock.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

usage='usage: tools/agent/test-dotnet <project dir or csproj> <filter>   e.g. tools/agent/test-dotnet src/SlideWorks.UnitTest "FullyQualifiedName~DisplayDateTests"'
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "$usage"
  exit 0
fi
agent_start
agent_refuse_repeat_each "$@"
[[ $# -eq 2 && -n "$2" ]] || agent_die 2 "a project and a filter are required; a whole project is never run. $usage" reason=missing-filter
project="$1" filter="$2"
case "$project" in
  *.sln | *.slnx) agent_die 2 "the solution is refused: name one test project" reason=solution ;;
esac
[[ -e "$project" ]] || project="$(agent_root)/$project"
if [[ -d "$project" ]]; then
  shopt -s nullglob
  csprojs=("$project"/*.csproj)
  shopt -u nullglob
  [[ ${#csprojs[@]} -eq 1 ]] || agent_die 2 "no single .csproj in $1" reason=no-project
  project="${csprojs[0]}"
fi
[[ -f "$project" && "$project" == *.csproj ]] || agent_die 2 "not a test project: $1" reason=no-project
agent_require git flock timeout
agent_env
echo "project: $project"
echo "filter: $filter"

rc=0
AGENT_BUILD_LOG="$AGENT_LOG" agent_build "$project" || rc=$?
case $rc in
  0) ;;
  3) agent_finish 3 reason=build-failed ;;
  4) agent_finish 4 reason=post-build-failed ;;
  5) agent_finish 5 reason=lock-wait-timed-out ;;
  *) agent_finish "$rc" reason=build-timed-out ;;
esac

# dotnet test --list-tests ignores --filter, so the filter is resolved with vstest's
# --ListFullyQualifiedTests, which applies --TestCaseFilter.
dll="$(dotnet msbuild "$project" -getProperty:TargetPath 2>>"$AGENT_LOG")"
[[ -f "$dll" ]] || agent_die 4 "built test assembly not found: ${dll:-none}" reason=no-assembly
list_tests() {
  local out="$1"
  shift
  local list_rc=0
  rm -f "$out"
  echo "== list tests $*" >>"$AGENT_LOG"
  agent_locked timeout -k 10 120 dotnet vstest "$dll" --ListFullyQualifiedTests "--ListTestsTargetPath:$out" "$@" >>"$AGENT_LOG" 2>&1 || list_rc=$?
  case $list_rc in
    0) ;;
    5) agent_finish 5 reason=lock-wait-timed-out ;;
    124) agent_finish 124 reason=list-timed-out ;;
    *) agent_die 1 "listing tests failed (exit $list_rc); see the log" reason=list-failed ;;
  esac
  [[ -f "$out" ]] || agent_die 1 "listing tests wrote no list; see the log" reason=list-failed
  listed="$(grep -c . "$out" || true)"
}
# The list files are named after this run's log, so concurrent runs never share them.
list_tests "${AGENT_LOG%.log}-selected.txt" "--TestCaseFilter:$filter"
selected="$listed"
max="${AGENT_MAX_TESTS:-300}"
[[ "$selected" -gt 0 ]] || agent_die 2 "the filter selects no test" reason=no-tests selected=0
[[ "$selected" -le "$max" ]] || agent_die 2 "the filter selects $selected tests, more than $max: narrow it" reason=too-many-tests "selected=$selected"
list_tests "${AGENT_LOG%.log}-all.txt"
total="$listed"
[[ "$selected" -lt "$total" ]] || agent_die 2 "the filter selects every test in the project ($total): narrow it" reason=whole-project "selected=$selected"
echo "selected: $selected of $total"

rc=0
echo "== dotnet test" >>"$AGENT_LOG"
agent_locked timeout -k 10 "${AGENT_TEST_TIMEOUT:-600}" \
  dotnet test "$project" --no-build --filter "$filter" -- NUnit.NumberOfTestWorkers=3 >>"$AGENT_LOG" 2>&1 || rc=$?
[[ $rc -ne 5 ]] || agent_finish 5 reason=lock-wait-timed-out
[[ $rc -ne 124 ]] || agent_finish 124 "selected=$selected" reason=test-timed-out
line="$(grep -E '^(Passed|Failed)! ' "$AGENT_LOG" | tail -n 1 || true)"
[[ -n "$line" ]] || agent_finish 1 "selected=$selected" reason=no-result-line
count() { sed -nE "s/.*$1: *([0-9]+).*/\1/p" <<<"$line"; }
passed="$(count Passed)" failed="$(count Failed)" skipped="$(count Skipped)"
mapfile -t failures < <(sed -nE 's/^ +Failed (.+) \[[^]]*\]$/\1/p' "$AGENT_LOG")
names=()
for name in "${failures[@]:0:10}"; do
  echo "FAILED $name"
  names+=("$name")
done
if [[ ${#failures[@]} -gt 10 ]]; then
  echo "+$((${#failures[@]} - 10)) more"
  names+=("+$((${#failures[@]} - 10)) more")
fi
counts=("passed=$passed" "failed=$failed" "skipped=$skipped")
if [[ ${#names[@]} -gt 0 ]]; then
  # Exact names, joined by |.
  counts+=("failed_tests=$(IFS='|'; echo "${names[*]}")")
fi
if [[ "$line" == Passed!* && $rc -eq 0 ]]; then
  agent_finish 0 "${counts[@]}"
fi
agent_finish 1 "${counts[@]}"
