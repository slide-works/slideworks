#!/usr/bin/env bash
# Type-checks the client, then runs named Playwright component specs (screenshots excluded) under the lock.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

usage='usage: tools/agent/test-ct <spec file...>   e.g. tools/agent/test-ct src/AppRoutes.spec.tsx'
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "$usage"
  exit 0
fi
agent_start
agent_refuse_repeat_each "$@"
[[ $# -gt 0 ]] || agent_die 2 "at least one spec file is required. $usage" reason=missing-files
root="$(agent_root)"
client="$root/src/SlideWorks.Client"
files=()
for arg in "$@"; do
  case "$arg" in
    --update-snapshots* | -u) agent_die 2 "--update-snapshots is not allowed: baselines are only made by CI" reason=update-snapshots ;;
    -*) agent_die 2 "options are not accepted ($arg): name spec files only. $usage" reason=option ;;
  esac
  path="$arg"
  [[ -e "$path" ]] || path="$root/$arg"
  [[ -e "$path" ]] || path="$client/$arg"
  [[ ! -d "$path" ]] || agent_die 2 "a directory is a full run: name spec files ($arg)" reason=directory
  [[ -f "$path" ]] || agent_die 2 "no such spec file: $arg" reason=no-file
  path="$(realpath "$path")"
  files+=("${path#"$client"/}")
done
agent_require pnpm flock timeout
agent_env
[[ -d "$client/node_modules" ]] || agent_die 4 "src/SlideWorks.Client/node_modules is missing: run pnpm install --frozen-lockfile there" missing=node_modules
echo "specs: ${files[*]}"

# Playwright CT never type-checks, so a type error would only show up in CI.
rc=0
echo "== tsc --noEmit" >>"$AGENT_LOG"
(cd "$client" && timeout -k 10 "${AGENT_BUILD_TIMEOUT:-900}" pnpm exec tsc --noEmit -p .) >>"$AGENT_LOG" 2>&1 || rc=$?
[[ $rc -ne 124 ]] || agent_finish 124 reason=tsc-timed-out
if [[ $rc -ne 0 ]]; then
  # The error lines stay in the log; stdout gets the first three.
  mapfile -t errors < <(grep -E 'error TS' "$AGENT_LOG" || true)
  printf '%s\n' "${errors[@]:0:3}"
  agent_finish 3 reason=type-errors "errors=${#errors[@]}"
fi

rc=0
json="${AGENT_LOG%.log}.json"
rm -f "$json"
echo "== playwright test" >>"$AGENT_LOG"
(
  cd "$client"
  export LD_LIBRARY_PATH="${PLAYWRIGHT_LD_LIBRARY_PATH:+$PLAYWRIGHT_LD_LIBRARY_PATH:}${LD_LIBRARY_PATH:-}"
  export NO_COLOR=1 FORCE_COLOR=0 PLAYWRIGHT_JSON_OUTPUT_NAME="$json"
  agent_locked timeout -k 10 "${AGENT_TEST_TIMEOUT:-600}" \
    pnpm exec playwright test -c playwright-ct.config.ts "${files[@]}" --grep-invert screenshot --reporter=list,json
) >>"$AGENT_LOG" 2>&1 || rc=$?
[[ $rc -ne 5 ]] || agent_finish 5 reason=lock-wait-timed-out
[[ $rc -ne 124 ]] || agent_finish 124 reason=test-timed-out
# Playwright's own exit code decides pass or fail; the counts and names come from its JSON report,
# which (unlike the list reporter's marks) knows an expected failure (test.fail) from a real one.
if [[ ! -s "$json" ]]; then
  agent_finish 1 reason=no-result-line "playwright_exit=$rc"
fi
summary="$(node - "$json" "$client" <<'NODE'
const report = JSON.parse(require('fs').readFileSync(process.argv[2], 'utf8'));
const path = require('path');
const dir = path.relative(process.argv[3], report.config.rootDir);
const bad = [];
let expectedFail = 0;
const walk = (suite, titles) => {
  const here = suite.file && !suite.title.includes('/') && suite.title !== suite.file ? [...titles, suite.title] : titles;
  for (const spec of suite.specs ?? []) {
    for (const test of spec.tests ?? []) {
      if (test.expectedStatus === 'failed' && test.status === 'expected') expectedFail++;
      if (test.status === 'unexpected' || test.status === 'flaky') {
        bad.push([`${path.join(dir, spec.file)}:${spec.line}:${spec.column}`, ...here, spec.title].join(' › '));
      }
    }
  }
  for (const child of suite.suites ?? []) walk(child, here);
};
for (const suite of report.suites ?? []) walk(suite, []);
const s = report.stats;
console.log([s.expected, s.unexpected, s.flaky, s.skipped, expectedFail].join(' '));
for (const name of [...new Set(bad)].sort()) console.log(name);
NODE
)" || agent_finish 1 reason=bad-report "playwright_exit=$rc"
{ read -r passed unexpected flaky skipped expected_fail; mapfile -t failures; } <<<"$summary"
failed=$((unexpected + flaky))
names=()
for name in "${failures[@]:0:10}"; do
  echo "FAILED $name"
  names+=("$name")
done
if [[ ${#failures[@]} -gt 10 ]]; then
  echo "+$((${#failures[@]} - 10)) more"
  names+=("+$((${#failures[@]} - 10)) more")
fi
counts=("passed=$passed" "failed=$failed" "flaky=$flaky" "skipped=$skipped")
[[ "$expected_fail" -eq 0 ]] || counts+=("expected_failures=$expected_fail")
if [[ ${#names[@]} -gt 0 ]]; then
  counts+=("failed_tests=$(IFS='|'; echo "${names[*]}")")
fi
if [[ $rc -eq 0 && "$failed" -eq 0 && "$unexpected" -eq 0 ]]; then
  agent_finish 0 "${counts[@]}"
fi
agent_finish 1 "${counts[@]}"
