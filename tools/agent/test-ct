#!/usr/bin/env bash
# Type-checks the client, then runs named Playwright component specs (screenshots excluded) under the lock.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

usage='usage: tools/agent/test-ct <spec file...>   e.g. tools/agent/test-ct src/AppRoutes.spec.tsx'
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "$usage"
  exit 0
fi
agent_start
agent_refuse_repeat_each "$@"
[[ $# -gt 0 ]] || agent_die 2 "at least one spec file is required. $usage" reason=missing-files
root="$(agent_root)"
client="$root/src/SlideWorks.Client"
files=()
for arg in "$@"; do
  case "$arg" in
    --update-snapshots* | -u) agent_die 2 "--update-snapshots is not allowed: baselines are only made by CI" reason=update-snapshots ;;
    -*) agent_die 2 "options are not accepted ($arg): name spec files only. $usage" reason=option ;;
  esac
  path="$arg"
  [[ -e "$path" ]] || path="$root/$arg"
  [[ -e "$path" ]] || path="$client/$arg"
  [[ ! -d "$path" ]] || agent_die 2 "a directory is a full run: name spec files ($arg)" reason=directory
  [[ -f "$path" ]] || agent_die 2 "no such spec file: $arg" reason=no-file
  path="$(realpath "$path")"
  files+=("${path#"$client"/}")
done
agent_require pnpm flock timeout
agent_env
[[ -d "$client/node_modules" ]] || agent_die 4 "src/SlideWorks.Client/node_modules is missing: run pnpm install --frozen-lockfile there" missing=node_modules
echo "specs: ${files[*]}"

# Playwright CT never type-checks, so a type error would only show up in CI.
rc=0
echo "== tsc --noEmit" >>"$AGENT_LOG"
(cd "$client" && timeout -k 10 "${AGENT_BUILD_TIMEOUT:-900}" pnpm exec tsc --noEmit -p .) >>"$AGENT_LOG" 2>&1 || rc=$?
[[ $rc -ne 124 ]] || agent_finish 124 reason=tsc-timed-out
if [[ $rc -ne 0 ]]; then
  grep -E 'error TS' "$AGENT_LOG" | head -n 20
  agent_finish 3 reason=type-errors "errors=$(grep -cE 'error TS' "$AGENT_LOG" || true)"
fi

rc=0
echo "== playwright test" >>"$AGENT_LOG"
(
  cd "$client"
  export LD_LIBRARY_PATH="${PLAYWRIGHT_LD_LIBRARY_PATH:+$PLAYWRIGHT_LD_LIBRARY_PATH:}${LD_LIBRARY_PATH:-}"
  export NO_COLOR=1 FORCE_COLOR=0
  agent_locked timeout -k 10 "${AGENT_TEST_TIMEOUT:-600}" \
    pnpm exec playwright test -c playwright-ct.config.ts "${files[@]}" --grep-invert screenshot --reporter=list
) >>"$AGENT_LOG" 2>&1 || rc=$?
[[ $rc -ne 5 ]] || agent_finish 5 reason=lock-wait-timed-out
[[ $rc -ne 124 ]] || agent_finish 124 reason=test-timed-out
count() { sed -nE "s/^ *([0-9]+) $1( .*)?\$/\1/p" "$AGENT_LOG" | tail -n 1; }
passed="$(count passed)" failed="$(count failed)" skipped="$(count skipped)"
passed="${passed:-0}" failed="${failed:-0}" skipped="${skipped:-0}"
if [[ "$passed" -eq 0 && "$failed" -eq 0 ]]; then
  agent_finish 1 reason=no-result-line
fi
mapfile -t failures < <(grep '✘' "$AGENT_LOG" | sed -E 's/^ *✘ +[0-9]+ +//; s/ \([0-9.]+m?s\)$//' | sort -u)
names=()
for name in "${failures[@]:0:10}"; do
  echo "FAILED $name"
  names+=("$name")
done
if [[ ${#failures[@]} -gt 10 ]]; then
  echo "+$((${#failures[@]} - 10)) more"
  names+=("+$((${#failures[@]} - 10)) more")
fi
counts=("passed=$passed" "failed=$failed" "skipped=$skipped")
if [[ ${#names[@]} -gt 0 ]]; then
  counts+=("failed_tests=$(IFS='|'; echo "${names[*]}")")
fi
if [[ $rc -eq 0 && "$failed" -eq 0 ]]; then
  agent_finish 0 "${counts[@]}"
fi
agent_finish 1 "${counts[@]}"
