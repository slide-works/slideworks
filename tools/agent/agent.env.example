# Host env file for tools/agent (contract K3). Copy it to $HOME/.config/slideworks/agent.env
# (or point SLIDEWORKS_AGENT_ENV at it) and uncomment what this host needs. Never commit the copy.

# The dotnet SDK folder, when dotnet is not in $HOME/.dotnet.
# DOTNET_ROOT=/opt/dotnet

# A command run with the repo root after each green dotnet build (a host-only fix, such as a native library patch).
# AGENT_POST_BUILD=my-post-build-fix

# Prepended to LD_LIBRARY_PATH for Playwright runs, when the host's browser libraries live outside the system paths.
# PLAYWRIGHT_LD_LIBRARY_PATH=/opt/pwlibs/usr/lib/x86_64-linux-gnu

# A command that prints ok when the cross-family reviewer CLI can answer (checked with a real call).
# AGENT_REVIEWER_CHECK='reviewer-cli "reply with the single word ok" </dev/null 2>/dev/null | tail -1'

# The shared lock file every build and test run takes, one command at a time.
# AGENT_LOCK=/tmp/slideworks-test.lock

# Seconds to wait for the lock before giving up with exit 5.
# AGENT_LOCK_WAIT=1500
