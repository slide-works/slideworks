#!/usr/bin/env bash
# Gets a fresh worktree to a built state: pnpm install, dotnet tool restore, solution build.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

usage="usage: tools/agent/bootstrap [--client-bundle]
Run inside a worktree. Loads the host env, prints the scratch dir, runs
'pnpm install --frozen-lockfile' in src/ (the pnpm workspace: the SPA, @slideworks/core and every
other package in src/pnpm-workspace.yaml) when src/node_modules is missing or older than
src/pnpm-lock.yaml, runs 'dotnet tool restore', then builds the solution.
--client-bundle also runs 'pnpm run build' (the acceptance tests serve that bundle).
Steps time out after AGENT_INSTALL_TIMEOUT (600 s). Exit 4: a missing tool or a failed
install or download; 3: a failed build; 124: a timeout. Safe to run twice: the second run skips the install."
bundle=0
for arg in "$@"; do
  case "$arg" in
    -h | --help)
      echo "$usage"
      exit 0
      ;;
    --client-bundle) bundle=1 ;;
    *)
      agent_start
      agent_die 2 "unknown argument: $arg
$usage" reason=bad-argument
      ;;
  esac
done
agent_start
agent_require git flock timeout pnpm
agent_env
root="$(agent_root)"
client="$root/src/SlideWorks.Client"
# The pnpm workspace root: one install and one lockfile for every package in src/pnpm-workspace.yaml.
workspace="$root/src"
scratch="$(agent_scratch)"
echo "scratch: $scratch"

# in_dir <dir> <command...>: runs a command in a directory, under AGENT_INSTALL_TIMEOUT (default 600 s).
# shellcheck disable=SC2329  # called through step
in_dir() (
  cd "$1"
  shift
  timeout -k 10 "${AGENT_INSTALL_TIMEOUT:-600}" "$@"
)

# step <name> <exit code on failure> <command...>: runs one command, output to the log.
# A timeout exits 124; any other failure exits with the given code (4 install or download, 3 build).
step() {
  local name="$1" failcode="$2" rc=0
  shift 2
  echo "== $name" >>"$AGENT_LOG"
  "$@" >>"$AGENT_LOG" 2>&1 || rc=$?
  [[ $rc -ne 124 && $rc -ne 137 ]] || agent_die 124 "$name timed out; see the log" reason="$name-timed-out"
  [[ $rc -eq 0 ]] || agent_die "$failcode" "$name failed (exit $rc); see the log" reason="$name-failed"
}

installed=skipped
if [[ ! -d "$workspace/node_modules" || "$workspace/node_modules" -ot "$workspace/pnpm-lock.yaml" ]]; then
  step pnpm-install 4 in_dir "$workspace" pnpm install --frozen-lockfile
  touch "$workspace/node_modules"
  installed=ran
fi
echo "pnpm install: $installed"
step dotnet-tool-restore 4 in_dir "$root" dotnet tool restore

rc=0
AGENT_BUILD_LOG="$AGENT_LOG" agent_build || rc=$?
case $rc in
  0) ;;
  3) agent_die 3 "build failed; see the log" reason=build-failed ;;
  4) agent_die 4 "post-build step failed; see the log" reason=post-build-failed ;;
  5) agent_die 5 "lock wait timed out" reason=lock-wait-timed-out ;;
  *) agent_die "$rc" "build timed out" reason=timed-out ;;
esac

if [[ $bundle -eq 1 ]]; then
  step client-bundle 3 in_dir "$client" pnpm run build
fi
agent_finish 0 "scratch=$scratch"
