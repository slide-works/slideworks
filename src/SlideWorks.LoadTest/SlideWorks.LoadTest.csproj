<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The harness is a console tool, not a test project: no test SDK, so `dotnet test` on the solution builds it and finds
       nothing to run. The SignalR client is the one the API tests already use. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
  </ItemGroup>

</Project>
