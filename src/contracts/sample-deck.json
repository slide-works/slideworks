      "slots": {
        "title": "Big batches hide the risk",
        "sub": "Why the quarter-long launch keeps slipping."
      }
    },
    {
      "number": 3,
      "layout": "bullets",
      "part": 1,
      "deepDive": false,
      "surface": "light",
      "steps": 4,
      "slots": {
        "kicker": "The pattern",
        "headline": "Every slip we had last year started as a big batch",
        "items": [
          {
            "lead": "Risk shows up late.",
            "text": "The first real customer sees it in week ten."
          },
          {
            "lead": "Merges get scary.",
            "text": "Long branches collide, so people stop merging."
          },
          {
            "lead": "Feedback arrives as a verdict,",
            "text": "not a nudge. By then it is too late to change course cheaply."
          },
          {
            "lead": "Nobody can say how far along we are,",
            "text": "because nothing is done until everything is."
          }
        ],
        "reveal": "one-by-one"
      }
    },
