        "kicker": "Before you split a story",
        "headline": "Four questions, in this order",
        "cards": [
          {
            "title": "Who notices?",
            "text": "Name the person who would see the change on day one."
          },
          {
            "title": "What's the thinnest version?",
            "text": "Hard-code anything that isn't the point."
          },
          {
            "title": "Can it hide behind a flag?",
            "text": "If not, what would have to change so it can?"
          },
          {
            "title": "What would we learn?",
            "text": "If the answer is \"nothing\", pick another slice."
          }
        ]
      }
    },
