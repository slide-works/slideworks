      "slots": {
        "kicker": "Make it stick",
        "headline": "Three rules for the first month",
        "rules": [
          {
            "title": "Merge to main every day",
            "text": "Unfinished work goes behind a flag, not on a branch."
          },
          {
            "title": "Demo something every Friday",
            "text": "To a customer if you can, and to the team if you can't."
          },
          {
            "title": "Split any story older than a week",
            "text": "Ship what's done, and make the rest a new story."
          }
        ]
      }
