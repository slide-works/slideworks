      "surface": "light",
      "steps": 0,
      "slots": {
        "kicker": "Slice it",
        "headline": "Slice by what a customer can do, not by layer",
        "do": [
          {
            "lead": "Start from one user action",
            "text": "and build every layer it needs, thinly."
          },
          {
            "lead": "Hard-code the second case.",
            "text": "Generalise when the third one arrives."
          },
          {
            "lead": "Ship behind a flag",
            "text": "to one team first, then widen."
          },
          {
            "lead": "Write the demo sentence first:",
            "text": "\"Now a customer can …\""
          }
        ],
        "comes_back": [
          "Feedback in days, not quarters.",
          "A merge that's small enough to review in one sitting."
        ],
        "avoid": [
          "\"API first, UI later.\" That's two batches, not two slices."
        ],
        "callout": {
          "tone": "bad",
          "text": "If a slice can't be demoed to a customer, it isn't a slice yet."
        }
      }
    },
