    "css": ".cl-0a1b2c3d-bar-chart__chart {\n  display: flex;\n  flex-direction: column;\n  gap: var(--sw-space-5);\n  color: var(--sw-ink);\n}\n.cl-0a1b2c3d-bar-chart__headline {\n  font-size: 64px;\n  font-weight: 700;\n}\n.cl-0a1b2c3d-bar-chart__bars {\n  display: flex;\n  flex-direction: column;\n  gap: var(--sw-space-4);\n}\n.cl-0a1b2c3d-bar-chart__row {\n  display: flex;\n  align-items: center;\n  gap: var(--sw-space-4);\n}\n.cl-0a1b2c3d-bar-chart__label {\n  width: 320px;\n  font-size: 32px;\n}\n.cl-0a1b2c3d-bar-chart__track {\n  flex-grow: 1;\n  height: 56px;\n  border-radius: var(--sw-radius-sm);\n  background: var(--sw-chip);\n}\n.cl-0a1b2c3d-bar-chart__bar {\n  width: calc(var(--v) * 1%);\n  height: 100%;\n  border-radius: var(--sw-radius-sm);\n  background: var(--sw-accent);\n}\n.cl-0a1b2c3d-bar-chart__bar.cl-0a1b2c3d-bar-chart__is-alert {\n  background: var(--sw-bad);\n}\n.cl-0a1b2c3d-bar-chart__note {\n  font-size: 28px;\n  color: var(--sw-muted);\n}\n",
