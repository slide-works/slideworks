{
  "name": "northwind-kickoff",
  "label": "Northwind kickoff",
  "purpose": "Northwind project kickoffs: a talk plus exercises the room does.",
  "basedOn": "workshop",
  "layouts": [
    "title",
    "divider",
    "bullets",
    "two-column",
    "practice",
    "compare",
    "quote",
    "image",
    "table",
    "numbered-cards",
    "rules",
    "cards",
    "close"
  ],
  "chrome": {
    "tracker": true,
    "footer": "author",
    "progress": true,
    "deepDivesOnDivider": true,
    "draft": true,
    "topBar": "accent"
  },
  "outline": [
    "Title",
    "Per part, a divider then one practice slide per idea",
    "Exercises as deep dives at the end of their part",
    "Rules or takeaways",
    "Close with the first step for Monday"
  ],
  "houseStyle": [
    "One headline per slide, written as a sentence that makes the point.",
    "A kicker naming the topic in two to four words.",
    "One idea per slide, with at most one callout.",
    "Speaker notes on every slide.",
    "Colour means something: positive, negative, accent. Never decoration.",
    "Optional material is marked as a deep dive rather than cut."
  ],
  "type": {
    "head": "Northwind Sans",
    "body": "Northwind Text",
    "headWeight": 800,
    "headTracking": "-0.02em"
  },
  "shape": {
    "radius": {
      "sm": 6,
      "md": 8,
      "lg": 12,
      "xl": 14
    },
    "shadow": "0 1px 2px rgb(15 23 42 / 0.06), 0 10px 28px rgb(15 23 42 / 0.08)"
  },
  "fonts": [
    {
      "role": "head",
      "family": "Northwind Sans",
      "file": "fonts/northwind-sans-700.woff2",
      "weight": 700,
      "style": "normal"
    },
    {
      "role": "head",
      "family": "Northwind Sans",
      "file": "fonts/northwind-sans-800.woff2",
      "weight": 800,
      "style": "normal"
    },
    {
      "role": "body",
      "family": "Northwind Text",
      "file": "fonts/northwind-text-400.woff2",
      "weight": 400,
      "style": "normal"
    },
    {
      "role": "mono",
      "family": "Northwind Mono",
      "file": "fonts/northwind-mono-400.woff2",
      "weight": 400,
      "style": "normal"
    }
  ],
  "logos": {
    "light": "logo-light.svg",
    "dark": "logo-dark.svg",
    "showOnDark": true
  },
  "titleArt": {
    "kind": "image",
    "file": "art.svg"
  },
  "ornament": {
    "dots": [
      "accent",
      "accent-2",
      "accent-glow",
      "extra-2"
    ]
  },
  "palette": {
    "paper": "#f7f8fa",
    "card": "#ffffff",
    "chip": "#eef1f6",
    "grid": "#e3e6ec",
    "ink": "#111827",
    "muted": "#5b6474",
    "accent": "#2f5bea",
    "accent-2": "#0e7490",
    "accent-dark": "#1e3a8a",
    "accent-light": "#e4eafd",
    "accent-glow": "#a5b8ff",
    "accent-past": "#b9c8f8",
    "on-accent": "#ffffff",
    "good": "#16a34a",
    "good-soft": "#dcfce7",
    "good-ink": "#166534",
    "bad": "#dc2626",
    "bad-soft": "#fdecec",
    "bad-ink": "#991b1b",
    "warn": "#ea580c",
    "warn-soft": "#ffedd5",
    "warn-ink": "#9a3412",
    "dd": "#c2410c",
    "on-dd": "#ffffff",
    "dd-on-night": "#fdba74",
    "night": "#0b1020",
    "night-ink": "#ffffff",
    "night-2": "#cbd5e1",
    "night-muted": "#8c97ad",
    "night-line": "#334155",
    "night-glow": "#2f5bea",
    "number-from": "#c3d0ff",
    "number-to": "#5b7cff",
    "stamp": "#fcd34d",
    "panel-accent": "#2f5bea",
    "panel-accent-ink": "#ffffff",
    "panel-positive": "#15803d",
    "panel-positive-ink": "#ffffff",
    "panel-negative": "#b91c1c",
    "panel-negative-ink": "#ffffff",
    "panel-inverse": "#0b1020",
    "panel-inverse-ink": "#ffffff",
    "extras": [
      {
        "name": "extra-1",
        "colour": "#050814",
        "ink": "#ffffff"
      },
      {
        "name": "extra-2",
        "colour": "#fde68a",
        "ink": "#111827"
      }
    ]
