<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.62.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Shouldly.FromAssert" Version="1.1.58" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Playwright" />
    <Using Include="NUnit.Framework" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!-- The shared test people and JSON shape checks, compiled from the API test project so both use the same ones. The
       poll seeds and their fixture are left out: they build on the API test project's own fixture, MCP client and
       registry stand-in, and acceptance tests never write poll rows. -->
  <ItemGroup>
    <Compile Include="..\SlideWorks.WebApi.Tests\Support\**\*.cs" Exclude="..\SlideWorks.WebApi.Tests\Support\GuestClient.cs;..\SlideWorks.WebApi.Tests\Support\PollSeed.cs;..\SlideWorks.WebApi.Tests\Support\PollRowSeed.cs;..\SlideWorks.WebApi.Tests\Support\PollTestFixture.cs" Link="Support\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Hosts the BFF (API plus the built SPA bundle in its wwwroot) on a real Kestrel port. -->
  <ItemGroup>
    <ProjectReference Include="..\SlideWorks.WebApi\SlideWorks.WebApi.csproj" />
  </ItemGroup>

</Project>
