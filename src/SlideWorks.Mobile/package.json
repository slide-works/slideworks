    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.3",
    "babel-preset-expo": "~58.0.27",
    "eslint": "^10.8.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.16",
    "prettier": "^3.6.0",
