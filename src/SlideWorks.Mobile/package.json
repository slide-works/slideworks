    "@sentry/react-native": "~8.28.1",
    "@slideworks/core": "workspace:*",
    "@tanstack/query-sync-storage-persister": "^5.108.4",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-persist-client": "^5.108.4",
    "expo": "~58.1.0",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
