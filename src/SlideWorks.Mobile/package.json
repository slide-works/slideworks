{
  "name": "slide-works-mobile",
  "private": true,
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "check": "prettier --check . && eslint . && tsc --noEmit -p . && vitest run && jest",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run && jest",
